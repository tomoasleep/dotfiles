#!/bin/bash

set -euo pipefail

if [ $# -eq 0 ]; then
  echo "Usage: with-onotify <command> [args...]" >&2
  exit 1
fi

COMMAND="$*"

if "$@"; then
  onotify -title "✅ Command Success" -message "$COMMAND"
  exit 0
else
  EXIT_CODE=$?
  onotify -title "❌ Command Failure" -message "$COMMAND"
  if [ -n "${ZELLIJ_PANE_ID:-}" ]; then
      zellij pipe --name zj-status-bar:cli:tab_alert --args "pane_id=$ZELLIJ_PANE_ID,exit_code=$EXIT_CODE"
  fi
  exit $EXIT_CODE
fi
